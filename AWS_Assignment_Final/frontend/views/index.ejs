<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AWS DevOps Deployment Dashboard</title>
  <style>
    :root {
      --bg: #0f172a;
      --card-bg: #1e293b;
      --accent: #38bdf8;
      --text: #f8fafc;
      --text-muted: #94a3b8;
      --success: #22c55e;
      --danger: #ef4444;
    }
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: var(--bg);
      color: var(--text);
      margin: 0;
      padding: 2rem;
      display: flex;
      justify-content: center;
    }
    .container { max-width: 820px; width: 100%; }
    header {
      text-align: center;
      margin-bottom: 2rem;
      border-bottom: 1px solid #334155;
      padding-bottom: 1rem;
    }
    h1 { color: var(--accent); margin-bottom: 0.5rem; }
    .badge {
      display: inline-block;
      padding: 0.25rem 0.75rem;
      border-radius: 9999px;
      font-size: 0.875rem;
      font-weight: 600;
    }
    .badge-success { background-color: rgba(34,197,94,0.2); color: var(--success); }
    .badge-danger  { background-color: rgba(239,68,68,0.2);  color: var(--danger); }
    .card {
      background: var(--card-bg);
      border-radius: 12px;
      padding: 1.5rem;
      margin-bottom: 1.5rem;
      box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
      border: 1px solid #334155;
    }
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px,1fr)); gap: 1rem; }
    .stat { background: #0f172a; padding: 1rem; border-radius: 8px; }
    .stat span { display: block; font-size: 0.8rem; color: var(--text-muted); margin-bottom: 4px; }
    .stat strong { color: var(--accent); }
    ul { list-style: none; padding: 0; }
    li {
      padding: 0.75rem 1rem;
      background: #0f172a;
      margin-bottom: 0.5rem;
      border-radius: 6px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <h1>☁️ AWS DevOps Deployment Dashboard</h1>
      <p>Express.js Frontend ↔ Flask Backend | AWS Multi-Architecture Assignment</p>
    </header>

    <div class="card">
      <h2>Backend Status</h2>
      <p>
        <% if (backendStatus === 'Connected') { %>
          <span class="badge badge-success">● Connected to Flask API</span>
        <% } else { %>
          <span class="badge badge-danger">✖ <%= backendStatus %></span>
        <% } %>
      </p>
      <div class="grid">
        <div class="stat">
          <span>Backend Endpoint</span>
          <strong><%= backendUrl %></strong>
        </div>
        <div class="stat">
          <span>Response Time</span>
          <strong><%= responseTime %></strong>
        </div>
      </div>
    </div>

    <% if (backendData && backendData.server) { %>
      <div class="card">
        <h2>Server Details</h2>
        <div class="grid">
          <div class="stat">
            <span>Container Hostname</span>
            <strong><%= backendData.server.hostname %></strong>
          </div>
          <div class="stat">
            <span>Environment</span>
            <strong><%= backendData.server.env %></strong>
          </div>
        </div>
      </div>
    <% } %>

    <% if (backendData && backendData.deployments) { %>
      <div class="card">
        <h2>Deployment Tasks</h2>
        <ul>
          <% backendData.deployments.forEach(function(d) { %>
            <li>
              <div>
                <strong>Task <%= d.task %>: <%= d.name %></strong>
              </div>
              <span class="badge badge-success"><%= d.status %></span>
            </li>
          <% }); %>
        </ul>
      </div>
    <% } %>
  </div>
</body>
</html>
